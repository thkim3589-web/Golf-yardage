<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explore_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting"
            android:textColor="@color/explore_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_recent_play_title"
            android:textColor="@color/explore_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/card_recent_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_explore_field"
            android:padding="16dp"
            android:layout_marginBottom="22dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_recent_course_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/explore_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="선산CC" />

                <TextView
                    android:id="@+id/text_recent_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/explore_text_secondary"
                    android:textSize="12sp"
                    tools:text="24℃ · 맑음" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_resume_round"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:backgroundTint="@color/accent_orange"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/recent_play_resume"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_recent_play_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_recent_play_empty"
            android:textColor="@color/explore_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="22dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_favorites_weather_title"
            android:textColor="@color/explore_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/container_favorites_weather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/text_favorites_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_favorites_weather_empty"
            android:textColor="@color/explore_text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_go_explore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_explore_field"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/home_go_explore"
            android:textColor="@color/explore_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
