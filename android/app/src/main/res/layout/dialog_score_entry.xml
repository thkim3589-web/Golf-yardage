<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/text_dialog_hole_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorRoundTextPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="1번 홀 · 파 4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/score_stroke_label"
            android:textColor="?attr/colorRoundTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialog_btn_score_minus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_number"
            android:backgroundTint="?attr/colorRoundButtonSecondaryBg"
            android:gravity="center"
            android:text="−"
            android:textColor="?attr/colorRoundTextPrimary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/dialog_text_score"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="?attr/colorRoundTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="4" />

        <TextView
            android:id="@+id/dialog_btn_score_plus"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_number"
            android:backgroundTint="?attr/colorRoundAccent"
            android:gravity="center"
            android:text="+"
            android:textColor="?attr/colorRoundOnAccent"
            android:textSize="20sp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_btn_save_shot"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        tools:text="1타 위치 기록"
        android:textColor="?attr/colorRoundButtonPrimaryText"
        app:backgroundTint="?attr/colorRoundButtonPrimaryBg"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/dialog_text_distance_basis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="?attr/colorRoundTextSecondary"
        android:textSize="12sp"
        tools:text="현재 위치 기준 · 길게 누르면 마지막 기록 취소" />

</LinearLayout>
