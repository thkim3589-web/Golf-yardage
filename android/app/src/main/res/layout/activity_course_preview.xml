<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/explore_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/explore_bg"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/explore_text_primary"
        app:titleTextColor="@color/explore_text_primary"
        tools:title="선산CC" />

    <TextView
        android:id="@+id/text_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:textColor="@color/explore_text_secondary"
        android:textSize="13sp"
        tools:text="경북 · 18홀 · 파 72" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/text_my_rating_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/explore_text_secondary"
            android:textSize="12sp"
            tools:text="내 별점" />

        <LinearLayout
            android:id="@+id/container_rating_stars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/edit_location_search"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_explore_field"
            android:paddingHorizontal="14dp"
            android:hint="@string/location_search_hint"
            android:textColor="@color/explore_text_primary"
            android:textColorHint="@color/explore_text_secondary"
            android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_search_location"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="@string/action_search_location"
            android:textColor="@color/explore_accent" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_hole_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_explore_field"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/text_stat_par"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/explore_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="4" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_label_par"
                android:textColor="@color/explore_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_explore_field"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/text_stat_yardage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/explore_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="396m" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_label_yardage"
                android:textColor="@color/explore_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_explore_field"
            android:paddingVertical="10dp">
            <TextView
                android:id="@+id/text_stat_hdcp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/explore_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_label_hdcp"
                android:textColor="@color/explore_text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/frame_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.6"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_explore_field">

        <com.google.android.gms.maps.MapView
            android:id="@+id/map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/text_map_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/explore_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/course_preview_map_placeholder"
            android:textColor="@color/explore_text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_save_searched_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/accent_orange"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/action_save_searched_location"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_register_tee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/explore_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:text="@string/action_register_tee"
            android:textColor="@color/explore_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_map_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge"
            android:backgroundTint="@color/explore_surface"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:textColor="@color/explore_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="위성" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/explore_border" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_holes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_round"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="16dp"
        android:text="@string/action_start_round"
        app:backgroundTint="@color/accent_orange"
        app:cornerRadius="12dp" />

</LinearLayout>
