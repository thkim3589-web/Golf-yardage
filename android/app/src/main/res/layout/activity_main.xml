<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorRoundMapBg">

    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 좌상단: 코스·홀 배지 (탭하면 홀 선택) -->
    <LinearLayout
        android:id="@+id/badge_course_hole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_floating_pill"
        android:backgroundTint="?attr/colorRoundBadgeBg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/text_hole_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorRoundHeaderText"
            android:fontFamily="?attr/roundDisplayFontFamily"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="선산CC · 1홀" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="▾"
            android:textColor="?attr/colorRoundAccent"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_gps_accuracy"
        style="@style/BadgeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="?attr/colorRoundBadgeBg"
        android:textColor="?attr/colorRoundBadgeText"
        app:layout_constraintTop_toBottomOf="@id/badge_course_hole"
        app:layout_constraintStart_toStartOf="@id/badge_course_hole"
        tools:text="정확도 ±5m" />

    <TextView
        android:id="@+id/text_weather"
        style="@style/BadgeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:backgroundTint="?attr/colorRoundBadgeBg"
        android:textColor="?attr/colorRoundBadgeText"
        app:layout_constraintTop_toBottomOf="@id/text_gps_accuracy"
        app:layout_constraintStart_toStartOf="@id/badge_course_hole"
        tools:text="24℃ · 맑음 · 바람 2.1m/s" />

    <!-- 우상단: 보정거리 카드 -->
    <LinearLayout
        android:id="@+id/card_distance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_floating_pill"
        android:backgroundTint="?attr/colorRoundBadgeBg"
        android:orientation="vertical"
        android:gravity="end"
        android:paddingHorizontal="14dp"
        android:paddingVertical="9dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/round_corrected_distance_label"
            android:textColor="?attr/colorRoundTextSecondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/text_corrected_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorRoundAccent"
            android:fontFamily="?attr/roundDisplayFontFamily"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="341m" />

        <TextView
            android:id="@+id/text_distance_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorRoundTextSecondary"
            android:textSize="10sp"
            tools:text="수평 334m | 높낮이 5.3m | PAR 4" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_target_distance"
        style="@style/BadgeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:backgroundTint="?attr/colorRoundTargetBadgeBg"
        android:textColor="?attr/colorRoundTargetBadgeText"
        app:layout_constraintTop_toBottomOf="@id/card_distance"
        app:layout_constraintEnd_toEndOf="@id/card_distance"
        tools:text="목표 지점까지 145m"
        tools:visibility="visible" />

    <!-- 좌측 플로팅 메뉴 -->
    <LinearLayout
        android:id="@+id/left_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/text_weather"
        app:layout_constraintBottom_toTopOf="@id/text_recommended_club"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.15">

        <TextView
            android:id="@+id/btn_gps"
            style="@style/FloatingCircleButton"
            android:text="@string/round_menu_gps" />

        <TextView
            android:id="@+id/btn_map_type"
            style="@style/FloatingCircleButton"
            android:layout_marginTop="10dp"
            tools:text="위성" />

        <TextView
            android:id="@+id/btn_score"
            style="@style/FloatingCircleButton"
            android:layout_marginTop="10dp"
            android:text="@string/round_menu_score" />

        <TextView
            android:id="@+id/btn_memo"
            style="@style/FloatingCircleButton"
            android:layout_marginTop="10dp"
            android:text="@string/round_menu_memo" />

        <TextView
            android:id="@+id/btn_help"
            style="@style/FloatingCircleButton"
            android:layout_marginTop="10dp"
            android:text="@string/round_menu_help" />

    </LinearLayout>

    <!-- 우측 코스 공략 메뉴 -->
    <LinearLayout
        android:id="@+id/right_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintBottom_toTopOf="@id/text_recommended_club"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_strategy"
            style="@style/FloatingPillButton"
            android:text="@string/round_menu_strategy" />

        <TextView
            android:id="@+id/btn_target"
            style="@style/FloatingPillButton"
            android:layout_marginTop="8dp"
            android:text="@string/round_menu_target" />

        <TextView
            android:id="@+id/btn_pin"
            style="@style/FloatingPillButton"
            android:layout_marginTop="8dp"
            android:text="@string/round_menu_pin" />

        <TextView
            android:id="@+id/btn_green_select"
            style="@style/FloatingPillButton"
            android:layout_marginTop="8dp"
            tools:text="그린선택: 핀" />

    </LinearLayout>

    <!-- 공략팁 오버레이 -->
    <TextView
        android:id="@+id/text_strategy_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_strategy_panel"
        android:backgroundTint="?attr/colorRoundStrategyPanelBg"
        android:padding="12dp"
        android:textColor="?attr/colorRoundStrategyPanelText"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/text_recommended_club"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="도그렉 왼쪽, 티샷은 페어웨이 우측을 노리세요."
        tools:visibility="visible" />

    <!-- 추천 클럽 슬림 배지 -->
    <TextView
        android:id="@+id/text_recommended_club"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginBottom="10dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_floating_pill"
        android:backgroundTint="?attr/colorRoundRecommendedBg"
        android:gravity="center"
        android:textColor="?attr/colorRoundRecommendedText"
        android:fontFamily="?attr/roundDisplayFontFamily"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottom_control_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="추천 클럽: 7번 아이언" />

    <!-- 하단 제어 바 -->
    <LinearLayout
        android:id="@+id/bottom_control_bar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="?attr/colorRoundHeaderBg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btn_touch_lock"
            style="@style/FloatingCircleButton"
            android:layout_marginTop="0dp"
            android:text="@string/round_menu_lock" />

        <TextView
            android:id="@+id/btn_shot_distance"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_floating_pill"
            android:backgroundTint="?attr/colorRoundButtonSecondaryBg"
            android:gravity="center"
            android:text="@string/round_mode_shot_distance"
            android:textColor="?attr/colorRoundButtonSecondaryText"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_remaining_distance"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_floating_pill"
            android:backgroundTint="?attr/colorRoundAccent"
            android:gravity="center"
            android:text="@string/round_mode_remaining_distance"
            android:textColor="?attr/colorRoundOnAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_more"
            style="@style/FloatingCircleButton"
            android:layout_marginStart="10dp"
            android:text="⋮" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
