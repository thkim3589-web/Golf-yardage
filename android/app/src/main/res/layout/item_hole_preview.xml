<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:foreground="?attr/selectableItemBackground">

    <View
        android:id="@+id/selection_bar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/accent_orange"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_hole_number"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_number"
                android:gravity="center"
                android:textColor="@color/text_on_green"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="1" />

            <TextView
                android:id="@+id/text_hole_par"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="파 4" />

            <View
                android:id="@+id/dot_coord_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/shape_dot" />

            <TextView
                android:id="@+id/text_coord_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="좌표 미입력" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_hole_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="46dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image_hole_illustration"
                android:layout_width="150dp"
                android:layout_height="230dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_logo_frame"
                android:backgroundTint="#14180F"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_hole_strategy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="공략팁: 등록된 공략법이 없습니다" />

            <TextView
                android:id="@+id/text_hole_slope"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="그린 경사: 정보 없음" />

            <TextView
                android:id="@+id/text_hole_green_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="그린 크기: 약 31m×20m"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/btn_manage_hole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/action_course_management"
                android:textColor="@color/accent_orange"
                android:textSize="12.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
